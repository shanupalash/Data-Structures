class BinarySearch {
    public static void main(String[] args) {
      int[] arr = {1,2,3,4,5,6,7,8,9};
      int len = arr.length;
      int l=0;
      int r = len-1;
      System.out.println(len);
      int target = 1;
      boolean found = true;
      int run=0;
     
     while(l<=r){
        
         int mid = (l+r)/2;
         if(arr[mid]==target){
             found = true;
             break;
         }
         else if(arr[mid]>target){
             r=mid-1;
        }
        else{
            l=mid+1;
        }     
     found = false;
      run++;
    }
    
    if(found){
        System.out.println("Element found");
    }else
     System.out.println("Element not found");
System.out.println(run);
}
}
